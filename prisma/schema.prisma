generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tên model và tên cột giữ đúng theo sơ đồ ERD của thầy.
// @@map đặt tên bảng thật trong PostgreSQL bằng chữ thường, vì "User" và "Order"
// là từ khóa SQL, nếu giữ nguyên thì khi gõ psql phải đặt dấu nháy kép ("Order").

model Role {
  roleid   Int    @id @default(autoincrement())
  rolename String @unique @db.VarChar(50)
  users    User[]

  @@map("roles")
}

model MemberShip {
  mid   Int    @id @default(autoincrement())
  mname String @unique @db.VarChar(50)
  score Int
  users User[]

  @@map("memberships")
}

model User {
  uid        Int        @id @default(autoincrement())
  username   String     @unique @db.VarChar(50)
  fullname   String     @db.VarChar(100)
  password   String     @db.VarChar(255)
  roleid     Int
  mid        Int
  role       Role       @relation(fields: [roleid], references: [roleid])
  membership MemberShip @relation(fields: [mid], references: [mid])
  orders     Order[]

  @@map("users")
}

model Product {
  pid      Int           @id @default(autoincrement())
  pname    String        @db.VarChar(100)
  price    Decimal       @db.Decimal(10, 2)
  quantity Int
  details  OrderDetail[]

  @@map("products")
}

model Order {
  oid       Int           @id @default(autoincrement())
  uid       Int
  createat  DateTime      @default(now())
  user      User          @relation(fields: [uid], references: [uid])
  details   OrderDetail[]
  shipments Shipment[]

  @@map("orders")
}

model OrderDetail {
  oid        Int
  pid        Int
  qty        Int
  unit_price Decimal @db.Decimal(10, 2)
  order      Order   @relation(fields: [oid], references: [oid])
  product    Product @relation(fields: [pid], references: [pid])

  @@id([oid, pid])
  @@map("order_details")
}

model Shipment {
  shipid Int    @id @default(autoincrement())
  oid    Int
  status String @default("PENDING") @db.VarChar(50)
  order  Order  @relation(fields: [oid], references: [oid])

  @@map("shipments")
}
